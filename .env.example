# Copy to .env on the DigitalOcean server. Never commit .env.
MAIL_TO=you@your-inbox.com
MAIL_FROM=noreply@yourdomain.com
# Optional SMTP (recommended). Gmail: smtp.gmail.com, port 587, app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SITE_URL=https://yourdomain.com
# Private 14-day report: open /stats.html?key=THIS_VALUE
STATS_KEY=change-this-to-a-long-secret
